# Terraform local directory
terraform/.terraform/

# Terraform state
terraform/*.tfstate
terraform/*.tfstate.*

# Terraform plan files
terraform/*.tfplan

# Terraform variable files that may contain secrets
terraform/*.tfvars

# Crash logs
terraform/crash.log
terraform/crash.*.log
# SSH private/public key files
terraform/zuri-ec2-key
terraform/zuri-ec2-key.pub
.env

# Local configuration backups
*.backup

# Grafana local database and backups
monitoring/grafana/backups/
